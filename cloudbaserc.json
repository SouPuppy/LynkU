{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "envId": "cloud1-d7gifgdpb8ad0ab8e",
  "functionRoot": "dist/cloudfunctions",
  "functions": [
    {
      "name": "users",
      "timeout": 30,
      "runtime": "Nodejs16.13",
      "handler": "index.main",
      "triggers": [
        {
          "name": "profile-outbox",
          "type": "timer",
          "config": "0 */1 * * * * *"
        }
      ]
    },
    {
      "name": "posts",
      "timeout": 30,
      "runtime": "Nodejs16.13",
      "handler": "index.main"
    },
    {
      "name": "comments",
      "timeout": 30,
      "runtime": "Nodejs16.13",
      "handler": "index.main",
      "triggers": [
        {
          "name": "notification-outbox",
          "type": "timer",
          "config": "0 */1 * * * * *"
        }
      ]
    },
    {
      "name": "messages",
      "timeout": 30,
      "runtime": "Nodejs16.13",
      "handler": "index.main"
    },
    {
      "name": "categories",
      "timeout": 3,
      "runtime": "Nodejs16.13",
      "handler": "index.main"
    },
    {
      "name": "drafts",
      "timeout": 3,
      "runtime": "Nodejs16.13",
      "handler": "index.main"
    },
    {
      "name": "governance",
      "timeout": 30,
      "runtime": "Nodejs16.13",
      "handler": "index.main"
    },
    {
      "name": "admin",
      "timeout": 10,
      "runtime": "Nodejs16.13",
      "handler": "index.main"
    }
  ]
}
