<nav-bar title="{{chatTitle}}" showBack="{{true}}" />
<view class="chat-page" style="height: calc(100vh - {{navHeight + keyboardHeight}}px);">
  <view class="chat-identity-note {{selfAnonymous ? 'chat-identity-anonymous' : ''}}">
    <text>{{identityNote}}</text>
    <button wx:if="{{!identityReady && !identityLoading && state !== 'loading'}}" class="inline-action identity-retry" hover-class="action-pressed" bindtap="onIdentityRetry">重试</button>
  </view>
  <view class="chat-protection">
    <button wx:if="{{blocked}}" class="inline-action" disabled="{{!identityReady || blockPending}}" hover-class="action-pressed" bindtap="onUnblockContact">{{blockPending ? '处理中…' : '已屏蔽 · 解除屏蔽'}}</button>
    <button wx:else class="inline-action" disabled="{{!identityReady || blockPending}}" hover-class="action-pressed" bindtap="onBlockContact">{{blockPending ? '处理中…' : '屏蔽此用户'}}</button>
  </view>
  <view wx:if="{{pollingActive}}" class="sync-warning">连接不稳定，正在重试</view>
  <scroll-view class="chat-scroll" scroll-y scroll-into-view="{{scrollTo}}" bindscroll="onScroll" enhanced show-scrollbar="{{false}}">
    <view wx:if="{{state === 'loading'}}" class="chat-skeleton">
      <view class="chat-sk-row chat-sk-peer">
        <view class="sk-block chat-sk-bubble chat-sk-bubble-wide"></view>
      </view>
      <view class="chat-sk-row chat-sk-mine">
        <view class="sk-block chat-sk-bubble"></view>
      </view>
      <view class="chat-sk-row chat-sk-peer">
        <view class="sk-block chat-sk-bubble chat-sk-bubble-mid"></view>
      </view>
      <view class="chat-sk-row chat-sk-mine">
        <view class="sk-block chat-sk-bubble chat-sk-bubble-wide"></view>
      </view>
    </view>

    <view wx:elif="{{state === 'error'}}" class="chat-empty" hover-class="action-pressed" bindtap="loadMessages">
      <text class="text-secondary">{{loadError || '聊天暂时无法加载，点击重试'}}</text>
    </view>

    <view wx:elif="{{timeline.length === 0}}" class="chat-empty">
      <text class="text-secondary">可以开始聊天了</text>
    </view>

    <block wx:else>
      <button wx:if="{{hasMoreHistory}}" class="history-control history-action" disabled="{{loadingHistory}}" hover-class="action-pressed" bindtap="onLoadEarlier">
        {{loadingHistory ? '加载中...' : historyError ? '加载失败，点击重试' : '查看更早消息'}}
      </button>
      <view wx:for="{{timeline}}" wx:key="key" id="{{item.messageId ? 'msg-' + item.messageId : 'pending-' + item.operationId}}" class="message-row" data-id="{{item.messageId}}">
        <view wx:if="{{item.messageId && item.messageId === firstUnreadId}}" class="history-control unread-divider">以下为新消息</view>
        <chat-bubble
          message="{{item}}"
          data-id="{{item.operationId}}"
          bindretry="onRetrySend"
          bindedit="onEditSend"
          binddiscard="onDiscardSend"
        />
      </view>
    </block>
    <view id="chat-bottom" style="height: 1px;"></view>
  </scroll-view>
  <button wx:if="{{newMessages}}" class="history-control history-action new-messages" hover-class="action-pressed" bindtap="scrollToBottom">{{newMessages}} 条新消息 ↓</button>
  <view wx:if="{{sendRecoveryError}}" class="composer-note">
    <text>{{sendRecoveryError}}</text><button class="inline-action" hover-class="action-pressed" bindtap="onRecoveryRetry">重试</button>
  </view>
  <view wx:if="{{draftWarning || sendStorageWarning}}" class="composer-note">{{draftWarning || sendStorageWarning}}</view>
  <view wx:elif="{{pending.length >= 20}}" class="composer-note">请先处理待发送的消息</view>

  <view wx:if="{{blocked}}" class="chat-blocked-note">你已屏蔽此用户，不能发送新消息。</view>
  <view wx:else class="chat-input-bar flex-row {{keyboardHeight > 0 ? 'keyboard-open' : ''}}">
    <view class="composer-field flex-1">
      <textarea
      class="chat-input"
      placeholder="输入消息..."
      value="{{inputText}}"
      bindinput="onInput"
      auto-height
      maxlength="5000"
      disabled="{{!identityReady}}"
      bindkeyboardheightchange="onKeyboardHeight"
      adjust-position="{{false}}"
    />
      <view wx:if="{{inputLength >= 4800}}" class="composer-count">{{inputLength}} / 5000{{inputLength >= 5000 ? ' · 已达上限' : ''}}</view>
    </view>
    <button class="chat-send-btn" hover-class="send-pressed" bindtap="onSend" size="mini" disabled="{{!canSend}}">发送</button>
  </view>
</view>
