.sync-warning { padding: 10rpx 24rpx; background: #fff4e5; color: #9a5b00; font-size: 22rpx; text-align: center; }
.chat-protection { flex-shrink: 0; padding: 10rpx 24rpx; color: var(--color-text-secondary); background: var(--color-bg-white); font-size: 22rpx; text-align: right; }
.chat-blocked-note { flex-shrink: 0; padding: 24rpx; background: #fff4e5; color: #9a5b00; text-align: center; font-size: 24rpx; }
.chat-page {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--color-bg);
}
.chat-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
  padding: var(--spacing-sm) 0;
}

.chat-input-bar {
  flex-shrink: 0;
  padding: var(--spacing-sm) var(--spacing-md);
  padding-bottom: calc(var(--spacing-sm) + env(safe-area-inset-bottom));
  background: var(--color-bg-white);
  border-top: 1rpx solid var(--color-border);
  gap: 12rpx;
  align-items: center;
}
.chat-input {
  min-width: 0;
  height: 68rpx;
  padding: 0 24rpx;
  background: var(--color-bg);
  border-radius: var(--radius-round);
  font-size: var(--font-sm);
}
.chat-send-btn {
  flex-shrink: 0;
  min-width: 116rpx;
  height: 68rpx;
  line-height: 68rpx;
  margin: 0;
  padding: 0 24rpx;
  background: var(--color-primary);
  color: #fff;
  border-radius: var(--radius-round);
}
.chat-send-btn::after { border: none; }
.chat-send-btn[disabled] { opacity: 0.55; }
.chat-skeleton {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: var(--spacing-md);
}
.chat-sk-row { display: flex; }
.chat-sk-peer { justify-content: flex-start; }
.chat-sk-mine { justify-content: flex-end; }
.chat-sk-bubble {
  width: 46%;
  height: 72rpx;
  border-radius: 18rpx;
}
.chat-sk-bubble-mid { width: 58%; }
.chat-sk-bubble-wide { width: 68%; }
.chat-empty { padding: 160rpx var(--spacing-md); text-align: center; }

.history-control { text-align: center; padding: 24rpx; color: var(--text-secondary); font-size: 24rpx; }

.chat-identity-note { padding: 12rpx 24rpx; color: var(--text-secondary, #666); font-size: 22rpx; text-align: center; }
