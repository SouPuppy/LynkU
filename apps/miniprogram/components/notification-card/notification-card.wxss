/* notification-card styles */
.notif-card {
  display: flex; align-items: flex-start; gap: var(--spacing-sm);
  padding: var(--spacing-md);
  background: var(--color-bg-white);
  position: relative;
}
.notif-card-pressed { background: var(--color-bg); }

.notif-body { flex: 1; display: flex; flex-direction: column; gap: 4rpx; min-width: 0; }
.notif-text { font-size: var(--font-md); color: var(--color-text); }
.notif-actor { font-weight: 500; }
.notif-action { color: var(--color-text-secondary); }
.notif-target { margin-top: 2rpx; }
.notif-source { margin-top: 2rpx; opacity: 0.78; }
.notif-time { margin-top: 4rpx; }

.notif-dot {
  position: absolute; top: 36rpx; right: var(--spacing-md);
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: var(--color-danger);
}
