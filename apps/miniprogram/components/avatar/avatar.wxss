/* avatar styles */
.avatar { border-radius: var(--radius-round); overflow: hidden; flex-shrink: 0; }
.avatar-sm { width: 56rpx; height: 56rpx; }
.avatar-md { width: 80rpx; height: 80rpx; }
.avatar-lg { width: 120rpx; height: 120rpx; }
.avatar { position: relative; }
.avatar-image { display: block; width: 100%; height: 100%; }
.avatar-placeholder { position: relative; width: 100%; height: 100%; background: #e7ebf0; }
.placeholder-head { position: absolute; width: 28%; height: 28%; left: 36%; top: 20%; border-radius: 50%; background: #a0a9b4; }
.placeholder-body { position: absolute; width: 58%; height: 40%; left: 21%; top: 55%; border-radius: 50% 50% 0 0; background: #a0a9b4; }
