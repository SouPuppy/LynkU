/* empty styles */
.empty { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 120rpx var(--spacing-md); }
.empty-icon {
  width: 100rpx; height: 100rpx; margin-bottom: var(--spacing-md);
  border: 3rpx solid var(--color-text-light); border-radius: 50%;
  position: relative;
}
.empty-icon::after {
  content: ''; position: absolute;
  bottom: 28rpx; left: 50%; transform: translateX(-50%);
  width: 4rpx; height: 28rpx; background: var(--color-text-light);
  border-radius: 2rpx;
}
.empty-text { font-size: var(--font-md); }
