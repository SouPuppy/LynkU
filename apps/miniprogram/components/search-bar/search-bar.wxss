/* search-bar styles */
.search-bar {
  background: var(--color-bg-white);
  padding: var(--spacing-xs) var(--spacing-md) var(--spacing-xs);
}

/* Wrapper keeps search box + history overlay together */
.search-box-wrapper {
  position: relative;
  z-index: 10;
}

.search-box {
  display: flex; align-items: center; background: var(--color-bg);
  border-radius: var(--radius-round); padding: 12rpx 24rpx;
}
.search-label { font-size: var(--font-sm); color: var(--color-text-secondary); margin-right: 12rpx; flex-shrink: 0; }
.search-input { flex: 1; font-size: var(--font-md); background: transparent; }
.search-cancel { font-size: var(--font-sm); color: var(--color-primary); padding-left: 12rpx; flex-shrink: 0; }

/* Category chips — always in flow below search box */
.category-row { white-space: nowrap; margin-top: var(--spacing-sm); display: flex; }
.category-chip {
  display: inline-block; padding: 8rpx 24rpx; margin-right: 12rpx;
  border-radius: var(--radius-round); font-size: var(--font-sm);
  background: var(--color-bg); color: var(--color-text-secondary);
  flex-shrink: 0;
}
.category-chip.active { background: var(--color-primary); color: #fff; }

/* History — absolute overlay below search box, floats above category chips */
.history-panel {
  position: absolute;
  top: calc(100% + 8rpx);
  left: 0; right: 0;
  background: var(--color-bg-white);
  border-radius: var(--radius-md);
  padding: var(--spacing-sm) var(--spacing-md);
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
}
.history-header { display: flex; justify-content: space-between; padding: var(--spacing-xs) 0; }
.history-title { font-size: var(--font-sm); color: var(--color-text-secondary); }
.history-clear { font-size: var(--font-sm); color: var(--color-primary); }
.history-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: var(--spacing-xs); }
.history-item { padding: 8rpx 24rpx; background: var(--color-bg); border-radius: var(--radius-round); font-size: var(--font-sm); }
