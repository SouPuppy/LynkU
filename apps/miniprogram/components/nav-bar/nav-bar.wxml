<view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar-inner" style="height: {{navBarHeight}}px;">
    <view wx:if="{{showBack}}" class="nav-back" bindtap="onBack">
      <view class="nav-back-icon"></view>
    </view>
    <text class="nav-title text-ellipsis">{{title}}</text>
    <view wx:if="{{showBack}}" class="nav-placeholder"></view>
  </view>
</view>
<view style="height: {{statusBarHeight + navBarHeight}}px;"></view>
