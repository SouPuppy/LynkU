<nav-bar title="{{title}}" showBack="{{true}}" />
<scroll-view class="legal-scroll" scroll-y enhanced>
  <view class="legal-page">
    <view wx:if="{{error}}" class="legal-notice"><text>{{error}}</text></view>
    <block wx:if="{{document.kind === 'about'}}">
      <view class="about-brand">
        <text class="about-name">{{appName}}</text>
        <text class="about-tagline">连接校园，分享日常</text>
        <text class="about-version">版本 {{appVersion}}</text>
      </view>
      <view class="about-intro">
        <block wx:for="{{document.sections}}" wx:key="id">
          <text wx:for="{{item.paragraphs}}" wx:for-item="paragraph" wx:key="*this" class="about-description">{{paragraph}}</text>
        </block>
      </view>
      <view class="about-links">
        <view class="about-row" data-kind="terms" bindtap="openDocument"><text>用户协议</text><view class="about-arrow"></view></view>
        <view class="about-row" data-kind="privacy" bindtap="openDocument"><text>隐私政策</text><view class="about-arrow"></view></view>
        <view class="about-row" data-kind="rules" bindtap="openDocument"><text>社区规范</text><view class="about-arrow"></view></view>
      </view>
      <view class="about-contact">
        <text class="contact-label">反馈与联系</text>
        <text class="contact-email">{{supportEmail}}</text>
      </view>
      <text wx:if="{{filingNumber}}" class="about-filing">{{filingNumber}}</text>
    </block>
    <block wx:elif="{{document}}">
      <view class="legal-article">
        <view wx:for="{{document.sections}}" wx:key="id" class="legal-section">
          <text wx:if="{{item.heading && index > 0}}" class="legal-heading">{{item.heading}}</text>
          <text wx:for="{{item.paragraphs}}" wx:for-item="paragraph" wx:key="*this" class="legal-paragraph">{{paragraph}}</text>
        </view>
      </view>
      <button wx:if="{{document.kind === 'privacy'}}" class="privacy-link" bindtap="openWechatPrivacy">微信用户隐私保护指引</button>
    </block>
  </view>
</scroll-view>
