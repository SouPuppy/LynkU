page { height: 100vh; display: flex; flex-direction: column; overflow: hidden; background: #f5f5f5; }
.legal-scroll { flex: 1; min-height: 0; height: 0; }
.legal-page { padding: 24rpx 32rpx 64rpx; padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }
.about-brand { display: flex; flex-direction: column; align-items: center; padding: 56rpx 0 36rpx; }
.about-name { font-size: 64rpx; font-weight: 700; color: var(--color-primary); line-height: 1.3; }
.about-tagline { font-size: 28rpx; color: var(--color-text); margin-top: 16rpx; }
.about-version { font-size: 24rpx; color: #777; margin-top: 12rpx; }
.about-intro { padding: 0 16rpx 36rpx; }
.about-description { display: block; font-size: 26rpx; color: #666; line-height: 1.8; margin-bottom: 12rpx; }
.about-links { background: #fff; border-radius: 20rpx; overflow: hidden; }
.about-row { display: flex; align-items: center; justify-content: space-between; min-height: 104rpx; padding: 0 28rpx; border-bottom: 1rpx solid #eee; font-size: 28rpx; }
.about-row:last-child { border-bottom: 0; }
.about-arrow { width: 12rpx; height: 12rpx; border-top: 2rpx solid #999; border-right: 2rpx solid #999; transform: rotate(45deg); margin-right: 6rpx; }
.about-contact { display: flex; flex-direction: column; align-items: center; padding-top: 40rpx; }
.contact-label { color: #777; font-size: 24rpx; }
.contact-email { color: var(--color-text); font-size: 28rpx; margin-top: 12rpx; }
.about-filing { display: block; text-align: center; font-size: 22rpx; color: #777; margin-top: 28rpx; }
.legal-notice { padding: 32rpx 0; color: #666; font-size: 28rpx; }
.legal-article { background: #fff; padding: 32rpx 28rpx 12rpx; border-radius: 20rpx; }
.legal-section { margin-bottom: 28rpx; }
.legal-heading { display: block; font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.legal-paragraph { display: block; white-space: pre-wrap; word-break: break-word; font-size: 28rpx; line-height: 1.85; margin-bottom: 20rpx; }
.privacy-link { margin-top: 28rpx; background: transparent; color: var(--color-primary); font-size: 26rpx; }
.privacy-link::after { border: 0; }
