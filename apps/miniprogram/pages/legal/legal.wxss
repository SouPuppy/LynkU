page { height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
.legal-scroll { flex: 1; min-height: 0; height: 0; }
.legal-page { padding: 24rpx 28rpx 64rpx; padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }
.legal-links { display: flex; flex-direction: row; flex-wrap: wrap; gap: 12rpx; margin-bottom: 24rpx; }
.legal-links button { font-size: 24rpx; line-height: 2.2; padding: 4rpx 20rpx; background: var(--color-bg-white); color: var(--color-primary); }
.legal-notice { background: #fff4e0; padding: 24rpx; border-radius: 12rpx; margin-bottom: 24rpx; color: #795514; }
.legal-meta { display: block; font-size: 24rpx; color: var(--color-text-secondary); margin-bottom: 16rpx; }
.legal-section { background: var(--color-bg-white); padding: 24rpx; border-radius: 16rpx; margin-bottom: 20rpx; }
.legal-heading { display: block; font-size: 32rpx; font-weight: 600; margin-bottom: 20rpx; }
.legal-paragraph { display: block; white-space: pre-wrap; word-break: break-all; font-size: 28rpx; line-height: 1.85; margin-bottom: 20rpx; }
.legal-footer { display: flex; flex-direction: column; gap: 20rpx; margin-top: 32rpx; font-size: 24rpx; word-break: break-all; }
.legal-footer button { width: 100%; font-size: 26rpx; padding: 12rpx; color: var(--color-primary); background: var(--color-bg-white); }
