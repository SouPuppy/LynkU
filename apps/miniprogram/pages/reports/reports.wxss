.reports-page { padding: 28rpx; }
.toolbar, .report-heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.toolbar { margin-bottom: 24rpx; font-size: 24rpx; color: #687181; }
.toolbar button { margin: 0; }
.report-card { background: #fff; border: 1rpx solid #e7eaf0; border-radius: 16rpx; padding: 28rpx; margin-bottom: 20rpx; }
.report-heading { font-size: 28rpx; font-weight: 600; }
.date, .secondary { font-size: 24rpx; color: #687181; font-weight: 400; }
.outcome, .resolution, .report-id { display: block; margin-top: 20rpx; }
.outcome { color: #1e4d8c; font-size: 28rpx; }
.resolution { font-size: 26rpx; line-height: 1.7; white-space: pre-wrap; word-break: break-all; }
.report-id { font-size: 20rpx; color: #687181; word-break: break-all; }
.empty { text-align: center; padding: 36rpx 12rpx; color: #687181; font-size: 26rpx; }
.empty button { margin-top: 20rpx; }
.more { color: #1e4d8c; font-size: 26rpx; }
