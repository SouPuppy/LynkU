/* topics page */
.topics-page { padding: var(--spacing-md); min-height: 100vh; background: var(--color-bg); }
.topics-header { margin-bottom: var(--spacing-lg); }
.topics-title { font-size: var(--font-xl); font-weight: 700; display: block; margin-bottom: 8rpx; }
.topics-grid { display: flex; flex-direction: column; gap: var(--spacing-sm); }
.topic-card {
  background: var(--color-bg-white); padding: var(--spacing-md);
  border-radius: var(--radius-md); display: flex; flex-direction: column; gap: 8rpx;
}
.topic-name { font-size: var(--font-lg); font-weight: 600; }
.topic-desc { line-height: 1.5; }
.topic-count { }
.topics-empty { padding: 120rpx var(--spacing-md); text-align: center; }
.topics-skeleton { display: flex; flex-direction: column; gap: var(--spacing-sm); }
.topic-sk-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  background: var(--color-bg-white);
  padding: var(--spacing-md);
  border-radius: var(--radius-md);
}
