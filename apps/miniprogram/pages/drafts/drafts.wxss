/* drafts page */
.drafts-page { min-height: 100vh; background: var(--color-bg-white); }
.drafts-empty { padding: 120rpx var(--spacing-md); text-align: center; }

.draft-list { }
.draft-row {
  display: flex; align-items: center; gap: var(--spacing-sm);
  padding: var(--spacing-md);
  border-bottom: 1rpx solid var(--color-border);
}
.draft-row-pressed { background: var(--color-bg); }

.draft-info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; overflow: hidden; }
.draft-title { font-size: var(--font-md); color: var(--color-text); }
.draft-preview { }
.draft-time { margin-top: 4rpx; }
.draft-delete {
  flex-shrink: 0; padding: 12rpx 20rpx;
  border-radius: var(--radius-round);
  background: var(--color-bg);
}
.drafts-skeleton { padding: 0 var(--spacing-md); }
.draft-sk-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-md) 0;
  border-bottom: 1rpx solid var(--color-border);
}
.draft-sk-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}
.draft-sk-delete {
  width: 72rpx;
  height: 44rpx;
  border-radius: var(--radius-round);
}
