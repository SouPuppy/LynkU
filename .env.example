# LynkU — CloudBase Configuration
# This documents configuration names; it is not a TypeScript config file.
#
# WeChat mini-programs don't support process.env.
# Public settings live in config/project.json; run npm run configure after changes.
# Secrets belong only to server environment settings, never client source.
# This file documents what needs to be set.

# CloudBase environment ID (from WeChat DevTools → Cloud Development)
CLOUDBASE_ENV=cloud1-d7gifgdpb8ad0ab8e

# Mini-program AppID (from WeChat Official Account Platform)
APPID=wxba2bcb0c71a5f33d

# App name
APP_NAME=LynkU

# Whether to enable debug logging in cloud functions
CLOUDBASE_DEBUG=false

### DO NOT UPLOAD #########################
# Mailgun (for sending mail)
MAILGUN_API_KEY=
###########################################
# Email service is paused by default. Set on the users cloud function only after restoring Mailgun.
EMAIL_VERIFICATION_ENABLED=false
