{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["node", "miniprogram-api-typings"],
    "lib": ["ES2020"],
    "baseUrl": "..",
    "paths": {
      "@lucky/contracts": ["packages/contracts/src/index.ts"],
